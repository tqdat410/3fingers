{
  "manifest_version": 3,
  "name": "3fingers",
  "version": "1.1.0",
  "version_name": "1.1.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": ["storage", "scripting", "webNavigation", "declarativeNetRequestWithHostAccess"],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png" },
  "action": { "default_title": "3fingers", "default_icon": { "16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png" } },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
