---
import '../styles/site.css';
import { text, repository } from '../lib/content.mjs';
const { locale = 'en', page = '', title = '3fingers', description, home = false } = Astro.props;
const t = text[locale];
const suffix = page ? `${page}/` : '';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || t.intro} />
    <title>{title === '3fingers' ? title : `${title} · 3fingers`}</title>
    <link rel="icon" type="image/png" href="/assets/icons/icon-32.png" />
    <link rel="preload" href="/assets/fonts/Ubuntu-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('3fingers-theme') === 'dark' ? 'dark' : 'light'; } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    {!home && <header class="header shell">
      <a class="brand" href={`/${locale}/`} aria-label={`3fingers · ${t.home}`}><img src="/assets/brand/logo-original.png" alt="" width="40" height="40" /><span>3fingers</span></a>
      <div class="header-links">
        <nav class="primary-nav" aria-label={locale === 'vi' ? 'Điều hướng chính' : 'Main navigation'}><a href={`/${locale}/guide/`} aria-current={page === 'guide' ? 'page' : undefined}>{t.guide}</a><a href={repository}>GitHub</a></nav>
        <nav aria-label={t.lang} class="languages">
          <a href={`/en/${suffix}`} lang="en" hreflang="en" data-locale="en" aria-label="English" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
          <a href={`/vi/${suffix}`} lang="vi" hreflang="vi" data-locale="vi" aria-label="Tiếng Việt" aria-current={locale === 'vi' ? 'page' : undefined}>VI</a>
        </nav>
      </div>
    </header>}
    <main id="main" class="shell"><slot /></main>
    <footer class="footer shell">
      <p>3fingers <span>· GPLv3</span></p>
      <nav aria-label={locale === 'vi' ? 'Liên kết' : 'Links'}><a href={`/${locale}/guide/`}>{t.guide}</a><a href={`/${locale}/privacy/`}>{t.privacy}</a><a href={repository}>GitHub</a><a href="/assets/fonts/UFL.txt" aria-label={locale === 'vi' ? 'Giấy phép phông Ubuntu' : 'Ubuntu font license'}>Ubuntu</a></nav>
    </footer>
    <script>
      for (const link of document.querySelectorAll('[data-locale]')) {
        link.addEventListener('click', () => {
          try { localStorage.setItem('3fingers-language', link.getAttribute('data-locale')); } catch {}
        });
      }
      const theme = document.querySelector<HTMLButtonElement>('#site-theme');
      function updateThemeButton() {
        if (!theme) return;
        const dark = document.documentElement.dataset.theme === 'dark';
        theme.setAttribute('aria-pressed', String(dark));
        theme.title = (dark ? theme.dataset.lightLabel : theme.dataset.darkLabel) || '';
        theme.setAttribute('aria-label', theme.title);
      }
      updateThemeButton();
      theme?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('3fingers-theme', next); } catch {}
        updateThemeButton();
      });
    </script>
  </body>
</html>
