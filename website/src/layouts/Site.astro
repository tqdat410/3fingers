---
import '../styles/site.css';
import { text, repository } from '../lib/content.mjs';
const { locale = 'en', page = '', title = '3fingers', description, home = false } = Astro.props;
const t = text[locale];
const suffix = page ? `${page}/` : '';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || t.intro} />
    <title>{title === '3fingers' ? title : `${title} · 3fingers`}</title>
    <link rel="icon" type="image/png" href="/assets/icons/icon-32.png" />
    <link rel="preload" href="/assets/fonts/Ubuntu-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('3fingers-theme') === 'dark' ? 'dark' : 'light'; } catch {}
      // Register before first paint; keep ordinary locale links and browser history.
      let finishScramble = () => {};
      function scrambleText() {
        finishScramble();
        const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!<>-_[]{}=+*^?#';
        const segmenter = typeof Intl.Segmenter === 'function' ? new Intl.Segmenter(document.documentElement.lang, { granularity: 'grapheme' }) : null;
        const slots = [];
        for (const element of document.querySelectorAll('[data-scramble]')) {
          const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT);
          const texts = [];
          while (walker.nextNode()) if (walker.currentNode.textContent.trim() && !walker.currentNode.parentElement.closest('[aria-hidden="true"]')) texts.push(walker.currentNode);
          for (const text of texts) {
            const original = text.textContent;
            const characters = segmenter ? Array.from(segmenter.segment(original), part => part.segment) : Array.from(original);
            const settles = characters.map((_, index) => .2 + .6 * index / characters.length + Math.random() * .15);
            const wrapper = document.createElement('span');
            wrapper.className = 'scramble-slot';
            const layout = document.createElement('span');
            layout.className = 'scramble-layout'; layout.textContent = original; layout.setAttribute('aria-hidden', 'true');
            const output = document.createElement('span');
            output.className = 'scramble-output'; output.setAttribute('aria-hidden', 'true');
            const accessible = document.createElement('span');
            accessible.className = 'sr-only'; accessible.textContent = original;
            wrapper.append(layout, output, accessible);
            text.replaceWith(wrapper);
            slots.push({ wrapper, text, output, characters, settles });
          }
        }
        let frame, last = -Infinity;
        const started = performance.now();
        document.documentElement.dataset.transition = 'language';
        finishScramble = () => {
          cancelAnimationFrame(frame);
          for (const slot of slots) slot.wrapper.replaceWith(slot.text);
          delete document.documentElement.dataset.transition;
          finishScramble = () => {};
        };
        function tick(now) {
          const progress = (now - started) / 550;
          if (progress >= 1 || matchMedia('(prefers-reduced-motion: reduce)').matches) { finishScramble(); return; }
          if (now - last >= 35) {
            for (const slot of slots) slot.output.textContent = slot.characters.map((letter, index) => /\s/u.test(letter) || progress >= slot.settles[index] ? letter : alphabet[Math.floor(Math.random() * alphabet.length)]).join('');
            last = now;
          }
          frame = requestAnimationFrame(tick);
        }
        tick(started);
      }
      addEventListener('pageswap', event => {
        finishScramble();
        event.viewTransition?.skipTransition();
      });
      addEventListener('pagereveal', event => {
        event.viewTransition?.skipTransition();
        const from = window.navigation?.activation?.from?.url;
        const source = from && new URL(from).pathname.match(/^\/(en|vi)\/$/);
        const target = location.pathname.match(/^\/(en|vi)\/$/);
        if (source && target && source[1] !== target[1] && !matchMedia('(prefers-reduced-motion: reduce)').matches) scrambleText();
      });
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    {!home && <header class="header shell">
      <a class="brand" href={`/${locale}/`} aria-label={`3fingers · ${t.home}`}><img src="/assets/brand/logo-original.png" alt="" width="40" height="40" /><span>3fingers</span></a>
      <div class="header-links">
        <nav class="primary-nav" aria-label={locale === 'vi' ? 'Điều hướng chính' : 'Main navigation'}><a href={`/${locale}/guide/`} aria-current={page === 'guide' ? 'page' : undefined}>{t.guide}</a><a href={repository} target="_blank" rel="noopener noreferrer">GitHub</a></nav>
        <nav aria-label={t.lang} class="languages">
          <a href={`/en/${suffix}`} lang="en" hreflang="en" data-locale="en" aria-label="English" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
          <a href={`/vi/${suffix}`} lang="vi" hreflang="vi" data-locale="vi" aria-label="Tiếng Việt" aria-current={locale === 'vi' ? 'page' : undefined}>VI</a>
        </nav>
      </div>
    </header>}
    <main id="main" class="shell"><slot /></main>
    <footer class="footer shell">
      <p>3fingers <span>· GPLv3</span></p>
      <nav aria-label={locale === 'vi' ? 'Liên kết' : 'Links'}><a href={`/${locale}/guide/`} data-scramble>{t.guide}</a><a href={`/${locale}/privacy/`} data-scramble>{t.privacy}</a><a href={repository} target="_blank" rel="noopener noreferrer">GitHub</a><a href="/assets/fonts/UFL.txt" aria-label={locale === 'vi' ? 'Giấy phép phông Ubuntu' : 'Ubuntu font license'}>Ubuntu</a></nav>
    </footer>
    <script>
      for (const link of document.querySelectorAll('[data-locale]')) {
        link.addEventListener('click', () => {
          try { localStorage.setItem('3fingers-language', link.getAttribute('data-locale')); } catch {}
        });
      }
      const theme = document.querySelector<HTMLButtonElement>('#site-theme');
      function updateThemeButton() {
        if (!theme) return;
        const dark = document.documentElement.dataset.theme === 'dark';
        theme.setAttribute('aria-pressed', String(dark));
        theme.title = (dark ? theme.dataset.lightLabel : theme.dataset.darkLabel) || '';
        theme.setAttribute('aria-label', theme.title);
      }
      updateThemeButton();
      let themeBusy = false;
      theme?.addEventListener('click', async () => {
        if (themeBusy || !theme) return;
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        const apply = () => {
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('3fingers-theme', next); } catch {}
          updateThemeButton();
        };
        if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) { apply(); return; }
        themeBusy = true;
        document.documentElement.dataset.transition = 'theme';
        const rect = theme.getBoundingClientRect();
        const x = rect.x + rect.width / 2, y = rect.y + rect.height / 2;
        const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        const transition = document.startViewTransition(apply);
        try {
          await transition.ready;
          document.documentElement.animate({ clipPath: [
            `circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`,
          ] }, { duration: 500, easing: 'ease-in-out', pseudoElement: '::view-transition-new(root)' });
          await transition.finished;
        } catch { /* A skipped animation still keeps the selected theme. */ }
        finally { themeBusy = false; delete document.documentElement.dataset.transition; }
      });
    </script>
  </body>
</html>
