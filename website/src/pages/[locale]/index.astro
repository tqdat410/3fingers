---
import Site from '../../layouts/Site.astro';
import SiteControls from '../../components/SiteControls.astro';
import { text, download } from '../../lib/content.mjs';
export function getStaticPaths() { return ['en', 'vi'].map(locale => ({ params: { locale } })); }
const { locale } = Astro.params;
const t = text[locale];
const socials = [['facebook','Facebook'],['instagram','Instagram'],['threads','Threads'],['tiktok','TikTok'],['x','X'],['reddit','Reddit'],['youtube','YouTube Shorts']];
---
<Site locale={locale} home title="Welcome to 3fingers">
  <div class="home-intro">
  <section class="hero">
    <div class="hero-brand">
      <img class="hero-logo" src="/assets/brand/logo-original.png" width="160" height="160" alt="3fingers" />
      <h1 class="hero-title" aria-label="3fingers — Multitask is not real!"><span class="hero-title-name" aria-hidden="true">3fingers</span><span class="hero-title-quote" aria-hidden="true"><span>Multitask</span> <span>is not real!</span></span></h1>
    </div>
    <p class="intro" data-scramble>{t.intro}</p>
    <SiteControls locale={locale} github docs />
    <div class="actions downloads">
      <button class="button store-download" type="button" disabled title={t.comingSoon}><img src="/social-icons/googlechrome.svg" width="22" height="22" alt="" /><span>Chrome Web Store<small data-scramble>{t.comingSoon}</small></span></button>
      <a class="button" href={download} target="_blank" rel="noopener noreferrer"><img src="/social-icons/github.svg" width="22" height="22" alt="" /><span data-scramble>{t.githubDownload}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M5 16v5h14v-5"/></svg></a>
    </div>
  </section>
  <section class="available" aria-label={t.available}>
    <ul class="social-list">{socials.map(([icon,name]) => <li data-social={icon}><img src={'/social-icons/' + icon + '.svg'} width="48" height="48" alt={name} /></li>)}</ul>
  </section>
  </div>
  <section class="installation" aria-labelledby="install-title">
    <div class="section-heading"><h2 id="install-title" data-scramble>{t.install}</h2><a class="text-link" href={'/' + locale + '/docs/#' + (locale === 'vi' ? 'cài-đặt' : 'install')} data-scramble>{t.fullGuide}<span aria-hidden="true"> →</span></a></div>
    <ol class="install-steps">{t.steps.map(step => <li><h3 data-scramble>{step.title}</h3><p data-scramble>{step.body}</p></li>)}</ol>
  </section>
</Site>
<script>
  const heading = document.querySelector('.hero-title');
  const output = heading?.querySelector('.hero-title-name');
  const quote = [...(heading?.querySelectorAll('.hero-title-quote > span') || [])].map(line => line.textContent);
  if (heading && output) {
    const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!<>-_[]{}=+*^?#';
    let frame = 0;
    function decode(lines) {
      cancelAnimationFrame(frame);
      const rows = lines.map(text => {
        const row = document.createElement('span');
        row.className = 'scramble-slot';
        const layout = document.createElement('span');
        layout.className = 'scramble-layout'; layout.textContent = text;
        const letters = document.createElement('span');
        letters.className = 'scramble-output';
        row.append(layout, letters);
        return { row, letters, characters: Array.from(text) };
      });
      output.replaceChildren(...rows.map(row => row.row));
      const started = performance.now();
      let last = -Infinity;
      function tick(now) {
        const progress = (now - started) / 550;
        if (progress >= 1 || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          output.replaceChildren(...lines.map(text => Object.assign(document.createElement('span'), { textContent: text })));
          return;
        }
        if (now - last >= 35) {
          for (const row of rows) row.letters.textContent = row.characters.map((letter, index) => /\s/u.test(letter) || progress >= .2 + .7 * index / row.characters.length ? letter : alphabet[Math.floor(Math.random() * alphabet.length)]).join('');
          last = now;
        }
        frame = requestAnimationFrame(tick);
      }
      tick(started);
    }
    let timer;
    let showQuote = false;
    function startCycle() {
      if (timer) return;
      timer = setInterval(() => { showQuote = !showQuote; decode(showQuote ? quote : ['3fingers']); }, 5000);
    }
    startCycle();
    addEventListener('pageshow', startCycle);
    addEventListener('pagehide', () => { clearInterval(timer); timer = undefined; cancelAnimationFrame(frame); showQuote = false; output.textContent = '3fingers'; });
  }
</script>
