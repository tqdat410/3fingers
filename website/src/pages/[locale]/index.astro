---
import Site from '../../layouts/Site.astro';
import { text, download } from '../../lib/content.mjs';
export function getStaticPaths() { return ['en', 'vi'].map(locale => ({ params: { locale } })); }
const { locale } = Astro.params;
const t = text[locale];
---
<Site locale={locale}>
  <section class="hero">
    <p class="eyebrow">{t.forChrome}</p>
    <h1>Multitask is not real!</h1>
    <p class="intro">{t.intro}</p>
    <div class="actions"><a class="button" href={download}>{t.download}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M5 16v5h14v-5"/></svg></a><a class="text-link" href={`/${locale}/guide/`}>{t.readGuide}<span aria-hidden="true"> →</span></a></div>
    <p class="install-note">{t.note}</p>
  </section>
  <section class="details">
    <div><h2>{t.heading}</h2><p>{t.detail}</p></div>
    <div><p class="section-label">{t.supported}</p><p>{t.sites}</p><p class="muted small">{t.independent}</p></div>
  </section>
  <section class="installation" aria-labelledby="install-title">
    <div class="section-heading"><h2 id="install-title">{t.install}</h2><a class="text-link" href={`/${locale}/guide/`}>{t.fullGuide}<span aria-hidden="true"> →</span></a></div>
    <ol class="install-steps">{t.steps.map(step => <li><h3>{step.title}</h3><p>{step.body}</p></li>)}</ol>
  </section>
  <section class="privacy-summary"><h2>{t.local}</h2><p>{t.privacyNote}</p><a class="text-link" href={`/${locale}/privacy/`}>{t.privacy}<span aria-hidden="true"> →</span></a></section>
</Site>
