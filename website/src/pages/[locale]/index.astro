---
import Site from '../../layouts/Site.astro';
import { text, download } from '../../lib/content.mjs';
export function getStaticPaths() { return ['en', 'vi'].map(locale => ({ params: { locale } })); }
const { locale } = Astro.params;
const t = text[locale];
---
<Site locale={locale}>
  <section class="hero">
    <img class="hero-logo" src="/assets/brand/logo-original.png" width="180" height="180" alt="" />
    <h1>3fingers<span>Multitask is not real!</span></h1>
    <p class="intro">{t.intro}</p>
    <div class="actions"><a class="button" href={download}>{t.download}<span aria-hidden="true">↗</span></a><a class="text-link" href={`/${locale}/guide/`}>{t.readGuide}<span aria-hidden="true"> →</span></a></div>
    <p class="install-note">{t.note}</p>
  </section>
  <section class="details">
    <div><h2>{t.heading}</h2><p>{t.detail}</p></div>
    <div><p>{t.sites}</p><p class="muted">{t.independent}</p></div>
  </section>
  <section class="privacy-summary"><h2>{t.local}</h2><p>{t.privacyNote}</p><a class="text-link" href={`/${locale}/privacy/`}>{t.privacy}<span aria-hidden="true"> →</span></a></section>
</Site>
