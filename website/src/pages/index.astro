---
import Site from '../layouts/Site.astro';
---
<Site home>
  <section class="hero language-entry"><div class="hero-brand"><img class="hero-logo" src="/assets/brand/logo-original.png" width="160" height="160" alt="3fingers" /><h1><span>Multitask</span> <span>is not real!</span></h1></div><p class="intro">Browse multiple social sites together in one tab.</p><div class="actions"><a class="button" data-locale="en" href="/en/">English</a><a class="text-link" data-locale="vi" href="/vi/" lang="vi">Tiếng Việt →</a></div></section>
  <script>
    let preference;
    try { preference = localStorage.getItem('3fingers-language'); } catch {}
    const locale = preference === 'en' || preference === 'vi' ? preference : /^vi(?:-|$)/i.test(navigator.language || '') ? 'vi' : 'en';
    location.replace(`/${locale}/`);
  </script>
</Site>
